# =============================================================================
# Variáveis de ambiente do frontend (Vite)
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# Variáveis prefixadas com VITE_ são expostas no bundle do browser.
# NUNCA coloque chaves privadas aqui.
#
# Referência: https://vitejs.dev/guide/env-and-mode
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (obrigatório)
# Encontre em: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key>

# ---------------------------------------------------------------------------
# WebRTC TURN Server — Suporte Remoto
# ---------------------------------------------------------------------------
# Necessário para que o suporte remoto funcione em redes corporativas com
# NAT simétrico (firewalls de empresa, VPN, 4G/5G com CGNAT).
# Sem TURN configurado, ~15–20% das conexões P2P falham silenciosamente.
#
# Como obter gratuitamente:
#   1. Metered.ca: https://www.metered.ca/stun-turn
#      → Free tier: 0,5 GB/mês — suficiente para uso moderado
#   2. OpenRelay (community): https://www.metered.ca/tools/openrelay
#      → Sem cadastro, sem custo, sem garantia de SLA
#
# Como obter com SLA:
#   1. Twilio Network Traversal Service
#      → https://www.twilio.com/en-us/stun-turn
#   2. Xirsys: https://xirsys.com
#
# Formato da URL:
#   turns:host:443    (TLS — recomendado, traversa firewalls)
#   turn:host:3478    (UDP/TCP — mais direto, pode ser bloqueado)
#
# ATENÇÃO: credenciais TURN ficam no bundle JavaScript (visíveis ao usuário).
# Use credenciais de curta duração (TTL ≤ 24h) geradas via API do provedor,
# ou credenciais de uso público/community sem dados sensíveis.
#
VITE_TURN_URL=                      # ex: turns:global.relay.metered.ca:443
VITE_TURN_USER=                     # usuário TURN
VITE_TURN_PASS=                     # senha TURN

# ---------------------------------------------------------------------------
# Outros (opcionais)
# ---------------------------------------------------------------------------
# VITE_SENTRY_DSN=                  # monitoramento de erros front-end

# ---------------------------------------------------------------------------
# E2E / TestSprite (copie para .env.mcp.local — NUNCA commitiar senhas)
# Ver docs/e2e/FIXTURES_E2E.md e docs/e2e/RUNBOOK.md
# ---------------------------------------------------------------------------
# E2E_EMAIL=
# E2E_PASSWORD=
# TESTSPRITE_API_KEY=
# TESTSPRITE_LOGIN_USER=
# TESTSPRITE_LOGIN_PASSWORD=
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# E2E_OUTBOUND_ALLOWLIST=5511989000650,5511973125846
# E2E_STRICT_OUTBOUND=false
# E2E_CADASTRO_LICENSE=tvmensal12
# E2E_CONSULTANT_ID=
