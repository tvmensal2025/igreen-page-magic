{
  "mcpServers": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=zlzasfhcxcznaprrragl"
    },
    "github": {
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/mcp-github.sh"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "postgres": {
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/mcp-postgres.sh"]
    },
    "analyzer": {
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/mcp-analyzer.sh"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "velip": {
      "url": "https://vox20.velip.com.br/mcpserver/velip",
      "headers": {
        "Authorization": "Bearer SEU_TOKEN_VELIP_30_CHARS"
      }
    },
    "TestSprite": {
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/mcp-testsprite.sh"]
    }
  }
}
