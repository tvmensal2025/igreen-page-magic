{
  "manifest_version": 3,
  "name": "iGreen Sync",
  "version": "1.5.0",
  "description": "Sincroniza seus clientes e rede do portal iGreen para o iGreen Cloud com 1 clique.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://escritorio.igreenenergy.com.br/*",
    "https://*.igreenenergy.com.br/*",
    "https://zlzasfhcxcznaprrragl.supabase.co/*",
    "https://igreen.cloud/*",
    "https://*.igreen.cloud/*",
    "https://*.lovable.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "iGreen Sync",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://igreen.cloud/*",
        "https://*.igreen.cloud/*",
        "https://*.lovable.app/*",
        "https://*.lovable.dev/*",
        "http://localhost/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
