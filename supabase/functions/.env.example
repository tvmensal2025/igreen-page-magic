# =============================================================================
# Secrets das Edge Functions iGreen
# =============================================================================
# Este arquivo documenta TODAS as variáveis usadas pelas edge functions.
# NÃO contém valores reais — use o painel Lovable / Supabase para configurar.
#
# Como conferir o que está realmente configurado:
#   Lovable: Workspace Settings → Project Settings → Secrets
#   Supabase: https://supabase.com/dashboard/project/zlzasfhcxcznaprrragl/settings/functions
#
# Última atualização: gerado pela auditoria de 24/05/2026.
# =============================================================================

# --- Supabase (auto-injetadas pelo runtime das edge functions) ---------------
SUPABASE_URL=                       # ✅ auto
SUPABASE_ANON_KEY=                  # ✅ auto
SUPABASE_SERVICE_ROLE_KEY=          # ✅ auto — NUNCA expor no frontend
SUPABASE_PUBLISHABLE_KEY=           # ✅ auto (alias de ANON em alguns casos)
SUPABASE_ENV=                       # opcional: 'production' | 'staging'

# --- WhatsApp / Whapi (canal ATIVO atualmente) -------------------------------
WHAPI_TOKEN=                        # OBRIGATÓRIO — token da instância Whapi
WHAPI_API_URL=                      # ex: https://gate.whapi.cloud

# --- WhatsApp / Evolution API (canal espelho/futuro) -------------------------
EVOLUTION_API_URL=                  # ex: https://igreen-evolution-api.b099mi.easypanel.host
EVOLUTION_API_KEY=                  # OBRIGATÓRIO p/ Evolution

# --- AI Gateway (Lovable) ----------------------------------------------------
LOVABLE_API_KEY=                    # ✅ auto via Lovable Cloud — NÃO rotacionar manualmente

# --- AI direto (Gemini / OpenAI) ---------------------------------------------
GEMINI_API_KEY=                     # usado por OCR e ai-generate-step-text
GOOGLE_AI_API_KEY=                  # alias legado de GEMINI_API_KEY (mantido por compat)
GOOGLE_SOLAR_API_KEY=               # Módulo Solar 3D — Solar API + Geocoding (server-only)
GOOGLE_MAPS_API_KEY=                # alias aceito por solar-geocode / solar-roof-analyze
SOLAR_USE_MOCK=true                 # dev sem Google: usa fixture SP (default se sem key)
OPENAI_API_KEY=                     # usado só pelo intent-classifier (opcional)

# --- ElevenLabs (TTS / Estúdio de Áudio) ------------------------------------
# OBRIGATÓRIO para o Estúdio de Áudio (mutirão). Nunca expor no frontend.
# Usado pela Edge Function tts-proxy → lê ELEVENLABS_API_KEY do servidor.
# Configurar em: Supabase Dashboard → Settings → Edge Functions → Secrets
ELEVENLABS_API_KEY=                 # OBRIGATÓRIO para gerar áudio do mutirão

# --- MinIO (mídia estática + vídeos comprimidos) -----------------------------
MINIO_SERVER_URL=                   # ex: https://minio.exemplo.com
MINIO_ROOT_USER=                    # admin
MINIO_ROOT_PASSWORD=                # senha
MINIO_BUCKET=                       # ex: igreen
MINIO_TOTAL_BYTES=                  # opcional — total p/ cálculo de % no painel

# --- Worker Portal 2 (cadastros iGreen via API direta) -----------------------
# O Portal 1 (worker-portal/, Playwright) foi descontinuado em 2026-06-19;
# todos os cadastros são despachados para o Portal 2 (worker-portal-2).
PORTAL2_WORKER_URL=                 # ex: http://igreen_portal-worker-2:3101
PORTAL2_WORKER_SECRET=              # bearer compartilhado Portal 2 ↔ edge
WORKER_SECRET=                      # secret aceito no callback worker→edge


# --- Auth interna entre Edge Functions (guarda IDOR / service mode) ----------
# Segredo compartilhado verificado no header `x-service-secret` por
# `_shared/caller-auth.ts` (resolveCaller → mode "service"). Lido via
# Deno.env.get("SERVICE_SHARED_SECRET"). Gerar com `openssl rand -hex 32`.
# Provisionar via `supabase secrets set` / Dashboard / Lovable — NUNCA hardcodar.
# Ver: .kiro/specs/evolution-multiconsultor-pronto/req5-secret-provisioning.md
SERVICE_SHARED_SECRET=              # OBRIGATÓRIO p/ guarda IDOR (REQ 5)

# --- Facebook / Meta Ads -----------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CAPI_ACCESS_TOKEN=         # CAPI centralizado (pixel global)
FACEBOOK_CAPI_PIXEL_ID=

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=                         # opcional — front e edge

# --- CORS (allowlist de origens das Edge Functions) --------------------------
# Lista separada por vírgula das origens autorizadas a chamar as edge functions.
# Lido por `_shared/cors.ts` (buildCors). Quando vazio, cai em fallback de
# desenvolvimento (localhost). Em produção, defina o domínio do portal.
# Ex: https://portal.igreen.com.br,https://app.igreen.com.br
ALLOWED_ORIGINS=                    # OBRIGATÓRIO em produção

# --- Velip Voice + SMS (módulo Ligação / Admin → Ligação) --------------------
# Módulo isolado em Admin → Ligação (/admin?tab=voz) — NÃO mexe no WhatsApp/bot.
# Provedor ativo: Velip (PSTN + MakeSMS). Twilio é legado e NÃO é usado.
# Provisionar: Dashboard → Edge Functions → Secrets  OU  supabase secrets set
# Doc: mem/features/voice-dialer.md
#
# Checklist:
#   1. Token API Velip (painel → Integrações → API) → VELIP_API_TOKEN
#   2. Gerar VELIP_WEBHOOK_AUTH: openssl rand -hex 32
#      Colar na URL de retorno Velip:
#      .../functions/v1/voice-dialer-webhook?auth=<VELIP_WEBHOOK_AUTH>
#   3. (Opcional) VELIP_CALLER_ID = BINA E.164 55DDNNNNNNNN
#   4. VOICE_DIALER_CRON_SECRET = openssl rand -hex 32
#      Mesmo valor em public.settings key=voice_dialer_cron_secret (pg_cron)
#   5. Deploy: scripts/deploy-voice-dialer.sh
#   6. Teste "Ligar teste" + SMS no Admin → Ligação
VELIP_API_TOKEN=                    # Bearer da conta Velip
VELIP_WEBHOOK_AUTH=                 # OBRIGATÓRIO — token na query ?auth= do webhook
VELIP_CALLER_ID=                    # OPCIONAL — BINA E.164 (55DDNNNNNNNN)
VOICE_DIALER_CRON_SECRET=           # OBRIGATÓRIO — header x-voice-dialer-cron-secret do pg_cron
SERVICE_SHARED_SECRET=              # auth alternativa do cron (x-service-secret)

# --- Feature flags / debug ---------------------------------------------------
MIDFLOW_QA_ENABLED=                 # 'true' liga QA midflow no bot-flow
FAKE_SB_DEBUG=                      # debug-only, usado em testes

# --- WebRTC TURN Server (Suporte Remoto) -------------------------------------
# Necessário para conexões P2P em redes corporativas com NAT simétrico
# (firewalls de empresa, VPN, 4G/5G com CGNAT). Sem TURN, ~15-20% das
# conexões podem falhar silenciosamente.
#
# Opções de provedor:
#   - Twilio Network Traversal Service (pago, alta disponibilidade)
#   - Metered.ca (free tier generoso para baixo volume)
#   - coturn auto-hospedado (docker: instrumentisto/coturn)
#   - OpenRelay (https://www.metered.ca/tools/openrelay) — sem custo, community
#
# Formato da URL: turn:host:porta ou turns:host:porta (TLS, recomendado)
# Estas variáveis são lidas em src/features/remote-support/screenShare.ts
# via import.meta.env.VITE_TURN_* (expostas ao frontend via Vite).
# ATENÇÃO: credentials TURN são públicas no bundle — use credenciais rotativas
# ou de curta duração (TTL de 12-24h via API do provedor).
VITE_TURN_URL=                      # ex: turns:global.relay.metered.ca:443
VITE_TURN_USER=                     # usuário TURN (pode ser rotativo)
VITE_TURN_PASS=                     # senha TURN (pode ser rotativa)

# =============================================================================
# Checklist de deploy novo:
#   1. Todos os marcados "OBRIGATÓRIO" preenchidos
#   2. Whapi vs Evolution: pelo menos um conjunto completo
#   3. MinIO_* completo se for usar upload de mídia
#   4. PORTAL2_WORKER_URL configurado se for usar cadastro automático
# =============================================================================
