# Cloudflare Pages — regras de cabeçalho HTTP (cache).
#
# OBJETIVO
# Garantir que toda atualização do app chegue ao usuário "mesmo com cache":
# o HTML, o Service Worker e o version.json NUNCA podem ser servidos de uma
# versão antiga pelo navegador ou pela CDN. Já os assets com hash no nome
# (immutable) podem ser cacheados "para sempre", pois um novo deploy gera
# nomes novos.

# Página principal e quaisquer rotas HTML: sempre revalida na rede.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Service Workers: nunca cachear — é o que destrava a troca de versão.
/sw-app.js
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Gatilho do version gate: sempre buscar da rede.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Manifesto do PWA: revalida sempre (é pequeno).
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# Assets com hash no nome (JS/CSS gerados pelo build): imutáveis e cacheáveis
# por 1 ano. Um deploy novo muda o hash, então não há risco de servir antigo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
